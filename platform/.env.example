# Public Supabase project details. The publishable key is designed to be exposed
# to browsers; database access must still be protected by RLS policies.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Used only by server-side auth actions to build email-confirmation links.
SITE_URL=http://localhost:3000

# NEVER add a Supabase service_role key or secret key to NEXT_PUBLIC_* variables,
# source files, or this example file.
